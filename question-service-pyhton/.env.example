# Ollama local (opcional para consultar o acervo revisado; necessário para processar com Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Gemini (opcional). Gere uma chave no Google AI Studio e informe somente no .env local.
# GEMINI_API_KEYS=sua-chave-aqui

# Limite de chamadas simultâneas por chave Gemini (1 a 16; padrão 4)
# STUDAI_GEMINI_PARALLEL_REQUESTS=4

# Modelo Ollama usado pelo processamento, se não escolher outro na interface.
# O modelo padrão do projeto é qwen3.5:4b.

# O cache pode crescer bastante; deixe no caminho padrão, ignorado pelo Git,
# ou defina outro diretório local.
# STUDAI_CACHE_DIR=simulados/cache
