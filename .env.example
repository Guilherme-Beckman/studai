# Ollama local (opcional para consultar o acervo revisado; necessário para processar com Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Gemini (opcional). Gere uma chave no Google AI Studio e informe somente no .env local.
# GEMINI_API_KEYS=sua-chave-aqui
# Alternativas aceitas quando houver apenas uma chave Gemini:
# GEMINI_API_KEY=sua-chave-aqui
# GOOGLE_API_KEY=sua-chave-aqui

# Provedores de nuvem compatíveis com OpenAI (opcionais; configure só os que usar).
# GROQ_API_KEY=sua-chave-groq
# OPENROUTER_API_KEY=sua-chave-openrouter
# DEEPSEEK_API_KEY=sua-chave-deepseek
# TOGETHER_API_KEY=sua-chave-together
# MISTRAL_API_KEY=sua-chave-mistral
# XAI_API_KEY=sua-chave-xai
# HF_TOKEN=seu-token-huggingface

# Outros provedores opcionais usados em configurações personalizadas.
# OPENAI_API_KEY=sua-chave-openai
# ANTHROPIC_API_KEY=sua-chave-anthropic
# OPENAI_COMPAT_API_KEY=sua-chave-openai-compativel

# Limite de chamadas simultâneas por chave Gemini (1 a 16; padrão 4)
# STUDAI_GEMINI_PARALLEL_REQUESTS=4

# Modelo Ollama usado pelo processamento, se não escolher outro na interface.
# O modelo padrão do projeto é qwen3.5:4b.

# O cache pode crescer bastante; deixe no caminho padrão, ignorado pelo Git,
# ou defina outro diretório local.
# STUDAI_CACHE_DIR=simulados/cache

# Docker Compose (opcionais): backup e fuso horário dos containers.
# STUDAI_BACKUP_INTERVAL_HOURS=24
# STUDAI_BACKUP_KEEP=7
# TZ=America/Campo_Grande
# STUDAI_UID=1000
# STUDAI_GID=1000
